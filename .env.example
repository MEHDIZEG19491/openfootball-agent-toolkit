# Run `npm run setup` to create .env with a random one-time setup token.
# The Docker configuration binds to localhost by default.
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/openfootball.sqlite
BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
NEXT_TELEMETRY_DISABLED=1
